datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String  @id
  email    String  @unique
  password String?
  name     String

  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  reports                 Report[]
  complianceAssessments   ComplianceAssessment[]
  securityTestingBookings SecurityTestingBooking[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id         String @id
  accountId  String @map("account_id")
  providerId String @map("provider_id")
  userId     String @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.Text
  password              String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Report {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(100)
  description String  @db.VarChar(500)
  content     String  @db.Text
  isPublic    Boolean @default(true) @map("is_public")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incidentType       String?   @map("incident_type") @db.VarChar(50)
  severity           String?   @db.VarChar(20)
  reportedAt         DateTime? @map("reported_at")
  affectedSystem     String?   @map("affected_system") @db.VarChar(255)
  affectedDepartment String?   @map("affected_department") @db.VarChar(50)
  affectedUsers      Int?      @map("affected_users")
  reporter           String?   @db.VarChar(100)
  evidenceFiles      Json?     @map("evidence_files")
  status             String    @default("OPEN") @db.VarChar(20)
  assignedAnalyst    String?   @map("assigned_analyst") @db.VarChar(100)

  @@map("reports")
}

model ComplianceAssessment {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id")

  organizationSector           String @map("organization_sector")
  organizationType             String @map("organization_type")
  criticalInfrastructureStatus String @map("critical_infrastructure_status")

  totalScore Float @default(0) @map("total_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ComplianceAnswer[]

  @@index([userId])
  @@map("compliance_assessments")
}

model ComplianceAnswer {
  id           Int @id @default(autoincrement())
  assessmentId Int @map("assessment_id")
  questionId   Int @map("question_id")

  answerValue   Int   @map("answer_value")
  awardedPoints Float @map("awarded_points")

  assessment ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("compliance_answers")
}

model SecurityTestingBooking {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id")
  name          String   @db.VarChar(100)
  testingType   String   @map("testing_type") @db.VarChar(50)
  scope         String   @db.Text
  startDate     String   @map("start_date") @db.VarChar(10)
  endDate       String   @map("end_date") @db.VarChar(10)
  status        String   @default("PENDING") @db.VarChar(20)
  termsAccepted Boolean  @map("terms_accepted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("security_testing_bookings")
}
